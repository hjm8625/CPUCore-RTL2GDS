# library model (basic model)
read_liberty -lib \
    /home/a0109/pdks/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib

# read design (-I to read GLOBAL.v)
read_verilog -I RTL \
    RTL/CPUCore.v \
    RTL/CTRL.v \
    RTL/ALU.v \
    RTL/RF.v \
    RTL/BTB.v \
    RTL/PHT.v

# design hierachy
hierarchy -check -top CPUCore

# generic synthesis
# it is only CPUCore, so I use flatten
# for the mapping SKY130, use noabc
synth -top CPUCore -flatten -noabc

# mapping (do not use special purpose cell.. )
dfflibmap -liberty \
    /home/a0109/pdks/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty \
    /home/a0109/pdks/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib \
    -dont_use sky130_fd_sc_hd__lpflow* \
    -dont_use sky130_fd_sc_hd__clkinv*
# using hilomap to map constant 0,1 to SKY130 low/high cells
hilomap \
    -hicell sky130_fd_sc_hd__conb_1 HI \
    -locell sky130_fd_sc_hd__conb_1 LO

clean
check

# report
stat -liberty \
    /home/a0109/pdks/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib

# for the OpenROAD, no attr, no expr, nodex
write_verilog -noattr -noexpr -nodec build/CPUCore_sky130.v
write_json build/CPUCore_sky130.json